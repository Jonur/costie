{
  "name": "costie",
  "description": "Costie is a real-time meeting cost calculator. Enter participants’ salaries and track the true cost of your meetings per second — privacy-friendly and client-side only.",
  "bugs": {
    "url": "https://github.com/Jonur/costie/issues",
    "email": "d.k.damilos@gmail.com"
  },
  "author": {
    "name": "Dimitris Damilos",
    "email": "d.k.damilos@gmail.com",
    "url": "https://github.com/Jonur"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonur/costie.git"
  },
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "all": "npm run typecheck && npm run lint && npm run build",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/bubblegum-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "classnames": "^2.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-super-switch": "^1.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": "26.x"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
